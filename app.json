{
  "expo": {
    "name": "Lively",
    "slug": "lively",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/primary_icon.png",
    "scheme": "lively",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/wordmark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nkenfab.lively"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/primary_icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/logo/wordmark.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nkenfab.lively",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/wordmark.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a1c94cf-7df6-47c2-af55-622b70c0e99e"
      }
    },
    "owner": "nkenfab"
  }
}
